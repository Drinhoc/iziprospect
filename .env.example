OPENAI_API_KEY=
GOOGLE_SHEETS_ID=
# Opção 1 (recomendada em plataformas): JSON compactado em uma linha com aspas duplas válidas
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Opção 2: JSON em base64 (evita problemas de escape)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
CRM_TARGET_GROUP_ID=
# Alias legados aceitos:
GROUP_ID_CRM_CONFIGURADO=
GROUP_ID_CRM=
CRM_GROUP_ID=
DISABLE_EVOLUTION_CONFIRMATION=true
DEFAULT_TIMEZONE=UTC
# PostgreSQL — obrigatório. Formato: postgresql://user:senha@host:5432/dbname
DATABASE_URL=postgresql://user:senha@host:5432/iziprospect
# Intervalo de sincronização automática Sheets→DB (minutos, padrão 15)
SHEETS_SYNC_INTERVAL_MINUTES=15
